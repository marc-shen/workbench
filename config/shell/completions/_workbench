#compdef workbench
local context state state_descr line
local -A opt_args
local -a choices rows query_args action_options
local component action root helper row group title choice previous previous_title option description
root=${SOFTWARE_HOME:-$HOME/Software}
helper=${WORKBENCH_HOME:-$root/config/workbench}/bin/workbench
[[ ! -x $root/bin/workbench ]] || helper=$root/bin/workbench
_arguments -C \
  '(-h --help)'{-h,--help}'[显示帮助]' \
  '--prefix=[Software 目录]:目录:_directories' \
  '--platform=[预览目标平台]:平台:(macos steamdeck fedora ubuntu debian)' \
  '--category=[用途分类]:分类:->category' '--tag=[标签]:标签:->tag' \
  '--plan[只显示计划]' '--json[结构化输出]' '--version[版本]' \
  '1:功能:->component' '*::参数:->args'
root=${opt_args[--prefix]:-$root}
query_args=(--prefix "$root")
[[ -z ${opt_args[--platform]-} ]] || query_args+=(--platform "$opt_args[--platform]")
case $state in
  category|tag)
    local query=categories
    [[ $state != tag ]] || query=tags
    choices=("${(@f)$("$helper" --complete "$query" 2>/dev/null)}")
    compadd -a choices ;;
  component)
    rows=("${(@f)$("$helper" "${query_args[@]}" --complete component-groups 2>/dev/null)}")
    choices=()
    for row in "${rows[@]}"; do
      [[ -n $row ]] || continue
      IFS=$'\t' read -r group title choice <<< "$row"
      if [[ -n $previous && $group != $previous ]]; then
        choices=("${(@o)choices}")
        _describe -t "workbench-$previous" "$previous_title" choices -J "workbench-$previous"
        choices=()
      fi
      choices+=("$choice")
      previous=$group previous_title=$title
    done
    if (( $#choices )); then
      choices=("${(@o)choices}")
      _describe -t "workbench-$previous" "$previous_title" choices -J "workbench-$previous"
    fi
    return 0 ;;
  args)
    component=$line[1]
    if [[ $component == list ]]; then
      case $words[CURRENT-1] in
        --category) choices=("${(@f)$("$helper" --complete categories 2>/dev/null)}"); compadd -a choices ;;
        --tag) choices=("${(@f)$("$helper" --complete tags 2>/dev/null)}"); compadd -a choices ;;
        *) compadd -- --category --tag --json ;;
      esac
      return 0
    fi
    words[1]=$component
    action=$words[2]
    action_options=()
    rows=("${(@f)$("$helper" "${query_args[@]}" --complete options "$component" "$action" 2>/dev/null)}")
    for row in "${rows[@]}"; do
      [[ -n $row ]] || continue
      option=${row%%:*} description=${row#*:}
      # _arguments syntax uses brackets for descriptions.
      description=${description//\[/\(}
      description=${description//\]/\)}
      case $option in
        '--only '*)
          if [[ $action == check || $action == link ]]; then
            action_options+=("--only=[$description]:范围:(all shell emacs helix)")
          else
            action_options+=("--only=[$description]:范围:(all shell emacs helix network)")
          fi ;;
        *' '*) action_options+=("${option%% *}=[$description]:参数值:") ;;
        *) action_options+=("${option}[$description]") ;;
      esac
    done
    _arguments -C \
      '(-h --help)'{-h,--help}'[显示帮助]' \
      '--plan[只显示计划]' '--json[结构化输出]' "${action_options[@]}" \
      '1:操作:->action' '*:对象:->target'
    case $state in
      action)
        choices=("${(@f)$("$helper" "${query_args[@]}" --complete action-descriptions "$component" 2>/dev/null)}")
        _describe -t workbench-actions '操作' choices -J workbench-actions ;;
      target)
        action=$words[2]
        choices=("${(@f)$("$helper" "${query_args[@]}" --complete targets "$component" "$action" 2>/dev/null)}")
        choices=("${(@o)choices:#}")
        (( ! $#choices )) || compadd -J workbench-targets -a choices ;;
    esac
    return 0 ;;
esac
